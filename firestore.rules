rules_version = '2';

/* NMR Digital Portal — Firestore security rules.
   Covers all three modules against the shared nmr-digital-estimates project:
   the Estimate Builder (estimates, library, settings, presence), the
   Project Planner (boards + subcollections, members), and Meeting Notes
   (meetings).

   Access is gated on a signed-in account whose address is on the company
   domain. The web API key in each app's page source is public by design and
   is NOT a secret — these rules, not the key, are what keep the data private.

   TWO THINGS MUST BE TRUE FOR THESE RULES TO HOLD:

   1. Both apps must sign users in BEFORE these rules go live, or every read
      is denied and both apps break.

   2. Self-signup must be OFF in the Firebase console
      (Authentication → Settings → User actions → untick "Enable create
      (sign-up)"). Accounts here are created by an admin, so nobody should be
      able to register themselves. Left on, anyone holding the public API key
      could call createUserWithEmailAndPassword with a made-up
      name@nmrevents.com address and satisfy the domain test below.

   There is deliberately no email_verified check: accounts created from the
   Firebase console start unverified, so requiring it would lock out the very
   people it is meant to admit. With self-signup disabled, the fact that an
   account exists at all is the real control. */

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in account on the NMR domain. The regex is anchored so an
    // address like "someone@nmrevents.com.attacker.test" cannot match, and
    // lower() keeps a capitalized address from being rejected.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email.lower().matches('^[^@]+@nmrevents[.]com$');
    }

    // Role lives on the requester's own member doc, so granting/revoking
    // admin is just editing that one field — no custom claims or a Cloud
    // Function to keep in sync. The extra read this costs is only paid on
    // writes gated by isAdmin(), not on every request.
    function isAdmin() {
      return isStaff()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('role', null) == 'admin';
    }

    // The one account allowed to grant itself admin while no admin yet
    // exists — every other path to the role requires an existing admin to
    // grant it, so without this nobody could ever become the first one.
    // Mirrored in index.html's BOOTSTRAP_ADMIN_EMAIL; keep the two in sync.
    function isBootstrapAdmin() {
      return request.auth.token.email.lower() == 'kwright@nmrevents.com';
    }

    /* ---- Estimate Builder ---- */
    match /estimates/{estimateId} { allow read, write: if isStaff(); }
    match /library/{itemId}       { allow read, write: if isStaff(); }
    match /settings/{settingsId}  { allow read, write: if isStaff(); }
    match /presence/{sessionId}   { allow read, write: if isStaff(); }

    /* ---- Project Planner ---- */
    // Lists and cards live under each board, so the recursive match covers
    // them on the same terms as the board itself.
    match /boards/{boardId} {
      allow read, write: if isStaff();
      match /{subCollection=**} { allow read, write: if isStaff(); }
    }

    // A member doc is either a real profile — keyed by its own uid, created
    // automatically the first time that person signs in — or a placeholder,
    // added by hand from Team Members before someone has an account yet so
    // cards can be assigned to them early. A real profile is editable by the
    // account it belongs to or by an admin (so an admin can fix a colleague's
    // display name, not just their own); a placeholder (flagged
    // isPlaceholder:true) isn't anyone's identity to protect, so any staff
    // member may create, edit, or remove one — except its role, which stays
    // admin-only (and blocked outright on a placeholder, see below) so
    // nobody can plant one on a doc id that later turns out to match a real
    // account's uid.
    //
    // The "role" field is stricter than the rest of the doc: a non-admin may
    // never touch their own (even though they can otherwise edit their own
    // doc), and the bootstrap address may set its own to 'admin' exactly
    // once, before any admin exists to grant it normally.
    match /members/{memberId} {
      allow read, delete: if isStaff();
      allow create: if isStaff()
        && (
          (request.auth.uid == memberId
            && (request.resource.data.get('role', null) != 'admin' || isBootstrapAdmin()))
          || (request.resource.data.isPlaceholder == true
              && request.resource.data.get('role', null) == null)
        );
      allow update: if isStaff()
        && (
          (resource.data.isPlaceholder == true
            && request.resource.data.get('role', null) == null)
          || isAdmin()
          || (request.auth.uid == memberId
              && request.resource.data.get('role', null) == resource.data.get('role', null))
          || (request.auth.uid == memberId
              && request.resource.data.get('role', null) == 'admin'
              && isBootstrapAdmin())
        );
    }

    /* ---- Meeting Notes ---- */
    // Meeting Notes also writes directly into boards/estimates (its "turn
    // this into a project card / estimate" actions), which the rules above
    // already cover for any staff account.
    match /meetings/{meetingId} { allow read, write: if isStaff(); }

    // Anything not named above is denied outright, so a collection added
    // later fails closed rather than being world-writable by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
